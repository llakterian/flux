OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Judge model — a stronger, separate model is the better call: the judge is
# scoring the generator, so sharing weights flatters the output.
JUDGE_MODEL=anthropic/claude-sonnet-5.5

