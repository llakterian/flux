# The model under test. Any OpenAI-compatible provider works.
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# The judge is a *different, larger* model: it scores the generator, so
# sharing weights would flatter the output. If JUDGE_MODEL is empty the judge
# falls back to the model under test -- which is not what you want.
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- alternatives (first key found wins, in this order) -----------------
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
